# ── Environments ─────────────────────────────────────────────
ml_env/
venv/
.venv/

# ── Python / Jupyter ─────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
Untitled*.ipynb

# ── Data (never committed — see data/README.md) ──────────────
WDM_dataset/
*.pkl
*.pkl.gz

# ── Model files ──────────────────────────────────────────────
# Ignored everywhere EXCEPT the deployed bundles in api/model/,
# which the API and the paper's latency numbers depend on.
*.keras
*.joblib
*.h5
*.pt
*.pth
!api/model/**/final_model.keras
!api/model/**/scaler.joblib

# Fold checkpoints and classical-model outputs
classical_baselines/results/*.png
classical_baselines/shap_*.png
classical_baselines/shap_*.csv
classical_baselines/saved_production_models/

# ── Generated outputs ────────────────────────────────────────
# results/*.csv are committed: they are the saved LOSO outputs
# that reproduce/paper_results.py regenerates the paper from.
reproduce/output/
logs/
runs/
tensorboard_logs/

# ── Editor / OS junk ─────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
.~lock*
